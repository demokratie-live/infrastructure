
DB_URL=mongodb://mongo/democracy?replicaSet=rs0&useNewUrlParser=true&useUnifiedTopology=true
BUNDESTAGIO_SERVER_URL=http://bundestagio-srv:3100/
STAGE=production
DEBUG=false
GRAPHIQL=false
NODE_ENV=production

# JWT
AUTH_JWT_TTL=24h
AUTH_JWT_REFRESH_TTL=7d

# SMS
SMS_VERIFICATION=true
SMS_SIMULATE=false
SMS_VERIFICATION_CODE_RESEND_BASETIME=1m

# In-App-Spenden (democracy-api src/donations, Runbook: democracy-api/docs/DONATIONS.md)
# Kill-Switch: erst nach Stripe-Einrichtung und Store-Freigabe auf true setzen.
# Geheime Werte (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SMTP_URL) gehören in das Secret
# democracy-api-secrets, nicht in diese Datei.
DONATIONS_ENABLED=false
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_DONATION_PRODUCT_ID=
# STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# STRIPE_PORTAL_LOGIN_URL=
# STRIPE_PORTAL_CONFIGURATION_ID=
